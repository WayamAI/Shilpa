# --- Azure OpenAI (the only cloud dependency for local development) ---
# Endpoint of your Azure OpenAI / Microsoft Foundry resource
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# Deployment name of a model that supports structured outputs (json_schema, strict)
AZURE_OPENAI_DEPLOYMENT=<deployment-name>
AZURE_OPENAI_API_VERSION=2024-10-21
# Either an API key, or leave empty to use Entra ID (az login / managed identity)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_TIMEOUT_S=90

# --- Local runtime ---
# DATABASE_URL=sqlite:///var/shilpa.db         (default)
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/shilpa
SHILPA_AUTH_MODE=dev
SHILPA_WORKER_TIMEOUT_S=120

# --- Per-job budgets (blueprint section 9) ---
SHILPA_BUDGET_CAD_EXECUTIONS=3
SHILPA_BUDGET_REPAIR_CALLS=2
SHILPA_BUDGET_INPUT_TOKENS=60000
SHILPA_BUDGET_OUTPUT_TOKENS=12000
SHILPA_BUDGET_ELAPSED_S=900
